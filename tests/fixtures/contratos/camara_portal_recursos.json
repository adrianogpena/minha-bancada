  "html": "<h3 class=\"gastos__titulo\">Verba de gabinete <a role=\"button\" title=\"Verba de gabinete\"\n                                                    data-content=\"Atualmente, cada deputado tem o limite mensal de R$ 165.806,07 para pagar salários de até 25 secretários parlamentares, que trabalham para o mandato, em Brasília ou nos estados. Eles são indicados diretamente pelos deputados, com salários de R$ 1.710,83 a R$ 25.958,90.\"\n                                                    data-toggle=\"popover\" href=\"#\" class=\"icone-ajuda\">?</a></h3>\n                                            <div class=\"gasto__row\">\n                                                <div class=\"gasto__col\">\n                                                    <p class=\"gastos__descricao\">Percentual gasto</p>\n                                \n                                                    <table id=\"percentualgastoverbagabinete\"\n                                                        class=\"js-chart js-chart--pie table table-borderless table-striped\"\n                                                        aria-label=\"Percentual gasto da verba de gabinete\">\n                                                        <thead>\n                                                            <tr>\n                                                                <th>Verba de gabinete</th>\n                                                                <th>Total (R$)</th>\n                                                                <th>Percentual</th>\n                                                            </tr>\n                                                        </thead>\n                                                        <tbody>\n                                                            <tr>\n                                                                <td>Gasto</td>\n                                                                <td>1.077.9